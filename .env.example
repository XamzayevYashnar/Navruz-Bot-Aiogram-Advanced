# ============ Telegram ============
BOT_TOKEN=
# Bir nechta admin: ADMIN_CHAT_ID=111111,222222
ADMIN_CHAT_ID=

# ============ POS API ============
BASE_URL=https://bj33zdcumr.yespos.uz/
ACCESS_TOKEN=
REFRESH_TOKEN=
# branch HEADER orqali yuboriladi (URL parametri emas!)
BRANCH_ID=1

# ===== Avtomatik login =====
# Token tugaganda bot o'zi qaytadan login qiladi (POST {AUTH_URL}/signIn).
# Bularsiz token tugagach bot to'xtaydi va sizga xabar yuboradi.
AUTH_URL=https://m1.yespos.uz
POS_ORG_ID=
POS_LOGIN=
POS_PASSWORD=
# Hisob bloklanmasligi uchun login urinishlari orasidagi eng kichik oraliq (soniya)
LOGIN_MIN_INTERVAL=60

# ============ Mahsulot ============
# Kelajakda ko'paytirish uchun: PRODUCT_KEY=16793,16794
PRODUCT_KEY=16793
PRODUCT_ID=6794
# Sotuv xabari sarlavhasidagi qisqa nom
PRODUCT_LABEL=Dark Chocolate

# ============ Monitoring ============
POLL_INTERVAL=30
# Qoldiq shu sondan tushsa ogohlantiradi
LOW_STOCK_THRESHOLD=20

# ============ Hisobot ============
# Kunlik hisobot vaqti (mahalliy vaqt)
REPORT_TIME=21:00
TIMEZONE=Asia/Tashkent
# Token tugashiga shuncha kun qolganda ogohlantiradi
TOKEN_WARN_DAYS=3

# ============ Render ============
# PORT va RENDER_EXTERNAL_URL ni Render O'ZI beradi — qo'lda yozmang.
# Lokal ishga tushirish uchun:
PORT=10000
# Self-ping (uxlab qolmaslik uchun). Render'da RENDER_EXTERNAL_URL avtomatik ishlatiladi.
# SELF_URL=
SELF_PING_INTERVAL=600

# Holat saqlanadigan fayl
STATE_FILE=state.json
